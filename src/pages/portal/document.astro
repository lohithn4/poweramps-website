---
/** Printable quotation / tax invoice / BOQ. Clients see their own; staff see all. "Download PDF" uses the browser's Save as PDF. */
import Base from '../../layouts/Base.astro';
import BrandMark from '../../components/BrandMark.astro';
import site from '../../data/site.json';
import { url } from '../../lib/url';

const a = site.address;
const companyAddress = [a.line1, a.line2, [a.city, a.pincode].filter(Boolean).join(' - '), a.state].filter(Boolean).join(', ');
---
<Base title="Document" noindex>
  <section class="docpage">
    <div class="docbar" data-bar>
      <a class="btn btn--ghost btn--sm" data-back href={url('/portal/')}>← Back</a>
      <div class="docbar__r">
        <select class="input" data-copy-sel title="Copy label" hidden>
          <option value="Original for recipient">Original for recipient</option>
          <option value="Duplicate for transporter">Duplicate for transporter</option>
          <option value="Triplicate for supplier">Triplicate for supplier</option>
          <option value="">No label</option>
        </select>
        <label class="switch" data-price-toggle hidden><input type="checkbox" data-hide-prices /> Hide prices</label>
        <button class="btn btn--primary btn--sm" type="button" data-accept hidden>Accept quotation</button>
        <button class="btn btn--ghost btn--sm" type="button" data-print>Download PDF / Print</button>
      </div>
    </div>

    <article class="sheet" data-sheet>
      <header class="sh-head">
        <div class="sh-brand">
          <BrandMark size={46} />
          <div>
            <div class="sh-co">{site.legalName}</div>
            <div class="sh-addr">{companyAddress}</div>
            <div class="sh-addr">
              {site.gst && <span>GSTIN: <b>{site.gst}</b></span>}
              {site.cin && <span> · CIN: {site.cin}</span>}
            </div>
            <div class="sh-addr">{[site.phone && `Ph: ${site.phone}`, site.email, new URL(import.meta.env.SITE ?? 'https://example.com').host].filter(Boolean).join(' · ')}</div>
          </div>
        </div>
        <div class="sh-title">
          <div class="sh-copy" data-copy-label></div>
          <h1 data-doc-title>Loading…</h1>
          <table class="sh-meta" data-meta></table>
        </div>
      </header>

      <section class="sh-parties" data-parties></section>
      <p class="sh-subject" data-subject></p>

      <table class="sh-lines" data-lines></table>

      <section class="sh-bottom">
        <div class="sh-left">
          <div data-words class="sh-words"></div>
          <div data-hsn></div>
          <div data-bank></div>
          <div data-notes></div>
        </div>
        <div class="sh-right">
          <table class="sh-totals" data-totals></table>
        </div>
      </section>

      <section class="sh-terms" data-terms></section>

      <footer class="sh-foot">
        <div class="sh-decl" data-decl></div>
        <div class="sh-sign"><div>For <b>{site.legalName}</b></div><div class="sh-sign__space"></div><div data-signatory>Authorised Signatory</div></div>
      </footer>
      <p class="sh-fine" data-footer></p>
    </article>
  </section>
</Base>

<style is:global>
  .docpage { padding: 24px 16px 80px; background: #e9ecf1; min-height: 100vh; }
  .docbar { max-width: 210mm; margin: 0 auto 14px; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 10px; align-items: center; }
  .docbar__r { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .docbar .input { min-height: 40px; width: auto; }
  .sheet { max-width: 210mm; margin: 0 auto; background: #fff; color: #111; padding: 12mm 12mm 10mm; box-shadow: 0 10px 40px rgb(0 0 0 / 12%); font-size: 12px; line-height: 1.45; }
  .sh-head { display: flex; justify-content: space-between; gap: 18px; padding-bottom: 10px; border-bottom: 2.5px solid var(--brand-primary); }
  .sh-brand { display: flex; gap: 12px; align-items: flex-start; }
  .sh-co { font-size: 17px; font-weight: 800; color: var(--brand-dark); letter-spacing: .01em; }
  .sh-addr { font-size: 11px; color: #333; }
  .sh-title { text-align: right; min-width: 200px; }
  .sh-title h1 { font-size: 20px; letter-spacing: .06em; text-transform: uppercase; color: var(--brand-accent); margin: 0 0 6px; }
  .sh-copy { font-size: 10px; text-transform: uppercase; letter-spacing: .08em; color: #555; }
  .sh-meta { margin-left: auto; border-collapse: collapse; font-size: 11.5px; }
  .sh-meta td { padding: 1px 0 1px 10px; text-align: right; }
  .sh-meta td:first-child { color: #555; }
  .sh-parties { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 12px; }
  .sh-box { border: 1px solid #cfd5df; border-radius: 4px; padding: 8px 10px; }
  .sh-box h4 { margin: 0 0 4px; font-size: 10px; letter-spacing: .08em; text-transform: uppercase; color: #555; }
  .sh-box .nm { font-weight: 700; font-size: 13px; }
  .sh-box div { white-space: pre-line; }
  .sh-subject { margin: 10px 0 0; font-size: 12.5px; }
  .sh-subject:empty { display: none; }
  .sh-lines { width: 100%; margin-top: 10px; border-collapse: collapse; font-size: 11.5px; }
  .sh-lines th { background: var(--brand-dark); color: #fff; padding: 6px 5px; text-align: left; font-weight: 600; font-size: 10.5px; letter-spacing: .03em; }
  .sh-lines td { padding: 6px 5px; border-bottom: 1px solid #e1e5ec; vertical-align: top; }
  .sh-lines tr:nth-child(even) td { background: #f7f8fa; }
  .sh-lines .r { text-align: right; white-space: nowrap; }
  .sh-lines .mk { color: #555; font-size: 10.5px; }
  .sh-bottom { display: grid; grid-template-columns: 1fr 260px; gap: 16px; margin-top: 12px; }
  .sh-totals { width: 100%; border-collapse: collapse; font-size: 12px; }
  .sh-totals td { padding: 4px 6px; border-bottom: 1px solid #e1e5ec; }
  .sh-totals td:last-child { text-align: right; white-space: nowrap; }
  .sh-totals .g td { font-size: 15px; font-weight: 800; background: var(--brand-dark); color: #fff; border: 0; }
  .sh-words { font-size: 11.5px; padding: 6px 8px; background: #f3f5f8; border-radius: 4px; margin-bottom: 10px; }
  .sh-mini { width: 100%; border-collapse: collapse; font-size: 10.5px; margin-bottom: 10px; }
  .sh-mini th, .sh-mini td { border: 1px solid #dde2ea; padding: 3px 5px; text-align: right; }
  .sh-mini th:first-child, .sh-mini td:first-child { text-align: left; }
  .sh-mini th { background: #f3f5f8; }
  .sh-left h4, .sh-terms h4 { margin: 0 0 4px; font-size: 10px; letter-spacing: .08em; text-transform: uppercase; color: #555; }
  .sh-bank { font-size: 11px; margin-bottom: 8px; }
  .sh-terms { margin-top: 12px; font-size: 11px; }
  .sh-terms ol { margin: 0; padding-left: 16px; }
  .sh-foot { display: flex; justify-content: space-between; align-items: flex-end; gap: 20px; margin-top: 18px; }
  .sh-decl { font-size: 10.5px; color: #444; max-width: 60%; }
  .sh-sign { text-align: right; font-size: 11.5px; }
  .sh-sign__space { height: 46px; }
  .sh-fine { margin: 10px 0 0; text-align: center; font-size: 9.5px; color: #777; }
  .hide-prices .pc { visibility: hidden; }
  @media (max-width: 720px) {
    .sheet { padding: 16px; }
    .sh-head, .sh-bottom, .sh-parties { display: block; }
    .sh-title { text-align: left; margin-top: 12px; }
    .sh-meta { margin-left: 0; }
    .sh-lines { display: block; overflow-x: auto; }
  }
  @media print {
    @page { size: A4; margin: 8mm; }
    .topbar, .header, .footer, .wa-float, .docbar, astro-dev-toolbar { display: none !important; }
    .docpage { padding: 0; background: #fff; }
    .sheet { box-shadow: none; padding: 0; max-width: none; }
    .sh-lines th, .sh-totals .g td { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    .sh-lines tr:nth-child(even) td, .sh-words, .sh-mini th { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    .sh-lines tr { break-inside: avoid; }
  }
</style>

<script>
  import { api, requireAuth, sitePath } from '../../scripts/api';
  import { $, esc, qs, toast } from '../../scripts/ui';
  import { amountInWords, inrFmt, stateName, posLabel } from '../../../shared/calc';
  import { fmtD } from '../../scripts/erp';

  const TITLES: Record<string, string> = { quotation: 'Quotation', invoice: 'Tax Invoice', boq: 'Bill of Quantities', purchase: 'Purchase Bill' };
  const m = (n: number) => inrFmt(n);
  const id = Number(qs('id'));

  async function load() {
    const me = await requireAuth();
    const staff = me.role !== 'client';
    $<HTMLAnchorElement>('[data-back]').href = sitePath(staff ? `/staff/doc/?id=${id}` : '/portal/');
    const { document: d, lines, byHsn, byRate, paid, balance, company, request } = await api(`/docs/${id}`);
    const title = TITLES[d.type];
    const draft = d.status === 'draft';
    document.title = `${title} ${d.number ?? '(draft)'} | ${document.title.split(' | ').pop()}`;
    $('[data-doc-title]').textContent = `${draft ? 'Draft ' : ''}${d.status === 'cancelled' ? 'Cancelled ' : ''}${title}`;
    const intra = !d.igst;

    const meta: [string, string][] = [[d.type === 'invoice' ? 'Invoice no.' : 'Number', d.number ?? '(not issued)'], ['Date', fmtD(d.doc_date)]];
    if (d.revision) meta.push(['Revision', String(d.revision)]);
    if (d.type === 'quotation' && d.valid_until) meta.push(['Valid until', fmtD(d.valid_until)]);
    if (d.type === 'invoice' && d.due_date) meta.push(['Due date', fmtD(d.due_date)]);
    if (d.ref_no) meta.push([d.type === 'purchase' ? 'Supplier bill' : 'Your PO / ref', `${d.ref_no}${d.ref_date ? ` dt. ${fmtD(d.ref_date)}` : ''}`]);
    if (request?.ref) meta.push(['Enquiry ref', request.ref]);
    if (d.type !== 'boq' && d.type !== 'purchase') meta.push(['Place of supply', posLabel(d.place_of_supply) || '—']);
    if (d.type === 'invoice' && d.reverse_charge) meta.push(['Reverse charge', 'Yes']);
    $('[data-meta]').innerHTML = meta.map(([k, v]) => `<tr><td>${esc(k)}</td><td><b>${esc(v)}</b></td></tr>`).join('');

    const billTo = `<div class="sh-box"><h4>${d.type === 'purchase' ? 'Supplier' : d.type === 'invoice' ? 'Bill to' : 'To'}</h4>
      <div class="nm">${esc(d.party_name ?? '—')}</div>${d.party_address ? `<div>${esc(d.party_address)}</div>` : ''}
      ${d.party_gstin ? `<div>GSTIN: <b>${esc(d.party_gstin)}</b></div>` : d.type === 'invoice' ? '<div>GSTIN: Unregistered</div>' : ''}
      ${d.party_state_code ? `<div>State: ${esc(stateName(d.party_state_code))} (${esc(d.party_state_code)})</div>` : ''}</div>`;
    const shipTo = d.ship_to ? `<div class="sh-box"><h4>Ship to</h4><div>${esc(d.ship_to)}</div></div>` : '<div></div>';
    $('[data-parties]').innerHTML = billTo + shipTo;
    $('[data-subject]').innerHTML = d.subject ? `<b>Subject:</b> ${esc(d.subject)}` : '';

    const hasDisc = lines.some((l: any) => l.discount_pct);
    $('[data-lines]').innerHTML = `<thead><tr><th>#</th><th>Description</th><th>HSN/SAC</th><th class="r">Qty</th><th class="r pc">Rate</th>${hasDisc ? '<th class="r pc">Disc</th>' : ''}<th class="r pc">GST</th><th class="r pc">Taxable</th><th class="r pc">Amount</th></tr></thead><tbody>
      ${lines.map((l: any, i: number) => `<tr><td>${i + 1}</td><td>${esc(l.description)}${l.make ? `<div class="mk">Make: ${esc(l.make)}</div>` : ''}</td><td>${esc(l.hsn ?? '')}</td>
        <td class="r">${l.qty} ${esc(l.unit ?? '')}</td><td class="r pc">${m(l.rate)}</td>${hasDisc ? `<td class="r pc">${l.discount_pct ? l.discount_pct + '%' : ''}</td>` : ''}<td class="r pc">${l.gst_rate}%</td><td class="r pc">${m(l.taxable)}</td><td class="r pc">${m(l.amount)}</td></tr>`).join('')}</tbody>`;

    const rows: [string, string, string?][] = [['Taxable value', m(d.taxable)]];
    if (intra) { rows.push(['CGST', m(d.cgst)], ['SGST', m(d.sgst)]); } else rows.push(['IGST', m(d.igst)]);
    if (d.round_off) rows.push(['Round off', (d.round_off > 0 ? '+' : '') + m(d.round_off)]);
    rows.push(['Total (₹)', m(d.total), 'g']);
    if (d.type === 'invoice' && paid > 0) rows.push(['Received', m(paid)], ['Balance due', m(balance)]);
    $('[data-totals]').innerHTML = rows.map(([k, v, c]) => `<tr class="${c ?? ''} pc"><td>${k}</td><td>${v}</td></tr>`).join('');
    $('[data-words]').innerHTML = `<b>Amount in words:</b> ${esc(amountInWords(d.total))}`;

    if (d.type === 'invoice' && byHsn?.length) {
      $('[data-hsn]').innerHTML = `<table class="sh-mini"><thead><tr><th>HSN/SAC</th><th>Taxable</th>${intra ? '<th>CGST</th><th>SGST</th>' : '<th>IGST</th>'}<th>Total tax</th></tr></thead><tbody>
        ${byHsn.map((h: any) => `<tr><td>${esc(h.hsn || '—')} @ ${h.rate}%</td><td>${m(h.taxable)}</td>${intra ? `<td>${m(h.cgst)}</td><td>${m(h.sgst)}</td>` : `<td>${m(h.igst)}</td>`}<td>${m(h.cgst + h.sgst + h.igst)}</td></tr>`).join('')}</tbody></table>`;
    } else if (d.type === 'quotation' && byRate?.length > 1) {
      $('[data-hsn]').innerHTML = `<table class="sh-mini"><thead><tr><th>GST rate</th><th>Taxable</th><th>Tax</th></tr></thead><tbody>${byRate.map((r: any) => `<tr><td>${r.rate}%</td><td>${m(r.taxable)}</td><td>${m(r.cgst + r.sgst + r.igst)}</td></tr>`).join('')}</tbody></table>`;
    }
    const b = company.bank;
    if ((d.type === 'invoice' || d.type === 'quotation') && (b.account || b.upi)) {
      $('[data-bank]').innerHTML = `<div class="sh-bank"><h4>Bank details for payment</h4>${[b.account_name && `A/c name: <b>${esc(b.account_name)}</b>`, b.name && `Bank: ${esc(b.name)}${b.branch ? `, ${esc(b.branch)}` : ''}`, b.account && `A/c no.: <b>${esc(b.account)}</b>`, b.ifsc && `IFSC: <b>${esc(b.ifsc)}</b>`, b.upi && `UPI: ${esc(b.upi)}`].filter(Boolean).join('<br>')}</div>`;
    }
    if (d.notes) $('[data-notes]').innerHTML = `<h4>Notes</h4><div style="white-space:pre-line">${esc(d.notes)}</div>`;
    const terms = String(d.terms ?? '').split('\n').map((t) => t.trim()).filter(Boolean);
    $('[data-terms]').innerHTML = terms.length ? `<h4>Terms & conditions</h4><ol>${terms.map((t) => `<li>${esc(t.replace(/^\d+[.)]\s*/, ''))}</li>`).join('')}</ol>` : '';
    $('[data-decl]').textContent = d.type === 'invoice' ? 'Declaration: We declare that this invoice shows the actual price of the goods described and that all particulars are true and correct.' : '';
    $('[data-signatory]').textContent = company.signatory || 'Authorised Signatory';
    $('[data-footer]').textContent = company.footer || '';

    if (d.type === 'invoice') {
      const sel = $<HTMLSelectElement>('[data-copy-sel]'); sel.hidden = false;
      const setCopy = () => ($('[data-copy-label]').textContent = sel.value);
      sel.addEventListener('change', setCopy); setCopy();
    }
    if (d.type === 'boq' || d.type === 'quotation') {
      $('[data-price-toggle]').hidden = false;
      $<HTMLInputElement>('[data-hide-prices]').addEventListener('change', (e) => $('[data-sheet]').classList.toggle('hide-prices', (e.target as HTMLInputElement).checked));
    }
    const acc = $<HTMLButtonElement>('[data-accept]');
    if (d.type === 'quotation' && ['issued', 'sent'].includes(d.status) && !staff) {
      acc.hidden = false;
      acc.onclick = async () => {
        if (!confirm(`Accept quotation ${d.number} for ₹ ${m(d.total)} and confirm your order?`)) return;
        acc.classList.add('is-busy');
        try { await api(`/docs/${id}/accept`, { body: {} }); toast('Thank you! Your order is confirmed.'); acc.hidden = true; if (request) setTimeout(() => (location.href = sitePath(`/portal/request/?id=${request.id}`)), 1200); }
        catch (e: any) { toast(e.message, 'err'); acc.classList.remove('is-busy'); }
      };
    }
    if (qs('print') === '1') setTimeout(() => window.print(), 400);
  }

  $('[data-print]').addEventListener('click', () => window.print());
  load().catch((e) => { if (e.message !== 'redirecting') { $('[data-doc-title]').textContent = 'Not available'; $('[data-meta]').innerHTML = `<tr><td>${esc(e.message)}</td></tr>`; } });
</script>
