---
// Local search landing pages: /electrical-panel-manufacturer-bangalore/, -karnataka/, -india/.
// Wording and FAQs per page live in src/data/regions.ts.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import LocationMap from '../components/LocationMap.astro';
import site from '../data/site.json';
import { PANEL_TYPES, typeHref } from '../data/panel-types';
import { faqJsonLd } from '../data/faqs';
import { REGIONS, regionHref, type Region } from '../data/regions';
import { directionsUrl, openMapUrl } from '../lib/location';
import { url } from '../lib/url';

export function getStaticPaths() {
  return REGIONS.map((r) => ({ params: { region: r.slug }, props: { r } }));
}
interface Props { r: Region }
const { r } = Astro.props;

const brand: string = (site as any).shortName || site.name;
const a = site.address;
const abs = (p: string) => new URL(url(p), Astro.site).href;
const pageUrl = abs(regionHref(r.slug));
const tel = site.phone ? `tel:${site.phone.replace(/\s/g, '')}` : '';
const types = PANEL_TYPES.filter((t) => t.slug !== 'lt-panel');
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const others = REGIONS.filter((o) => o.slug !== r.slug);
const faqs = r.faqs;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: abs('/') },
        { '@type': 'ListItem', position: 2, name: r.h1, item: pageUrl },
      ],
    },
    {
      '@type': 'Service',
      name: r.h1,
      serviceType: 'Electrical panel manufacturing',
      description: r.description,
      url: pageUrl,
      provider: { '@id': abs('/#business') },
      areaServed: r.areaServed,
    },
    faqJsonLd(faqs),
  ],
};
---
<Base title={r.title} description={r.description} jsonLd={jsonLd}>
  <section class="page-hero blueprint on-dark">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={url('/')}>Home</a><span aria-hidden="true">/</span>
        <span>{r.place}</span>
      </nav>
      <span class="eyebrow">{brand} · {r.eyebrow}</span>
      <h1>{r.h1}</h1>
      <p>{r.lead}</p>
      <div class="bl-actions">
        <a class="btn btn--primary" href={url('/build/')}><Icon name="layers" size={18} />Build your panel online <Icon name="arrow" size={18} /></a>
        {tel && <a class="btn btn--ghost" href={tel}><Icon name="phone" size={18} />Call {site.phone}</a>}
      </div>
      <ul class="bl-trust">
        <li><Icon name="check" size={15} />Manufacturer since {site.established}</li>
        <li><Icon name="check" size={15} />Factory tested</li>
        <li><Icon name="check" size={15} />Dispatch in 3–7 days</li>
        <li><Icon name="check" size={15} />Installation &amp; service</li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <span class="eyebrow">Made in Bengaluru</span>
      <h2 class="bl-h2">{r.typesTitle}</h2>
      <ul class="bl-types">
        {types.map((t) => (
          <li>
            <a href={url(typeHref(t.slug))}><strong>{cap(t.short)}</strong> <Icon name="arrow" size={14} /></a>
            <p>{t.description}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section bl-paper">
    <div class="wrap bl-two">
      <div>
        <span class="eyebrow">Industries</span>
        <h2 class="bl-h2">Who we build for</h2>
        <ul class="bl-chips">{site.industries.map((i) => <li>{i}</li>)}</ul>
      </div>
      <div>
        <span class="eyebrow">{r.whyEyebrow}</span>
        <h2 class="bl-h2">{r.whyTitle}</h2>
        <ul class="bl-list">
          {r.why.map((w) => <li><Icon name="check" size={16} />{w}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap bl-two">
      <div>
        <span class="eyebrow">Visit us</span>
        <h2 class="bl-h2">Our works in Bangalore / Bengaluru</h2>
        <address class="bl-addr">
          <strong>{site.legalName}</strong><br />
          {a.line1},<br />{a.line2},<br />{a.city} (Bangalore), {a.state} {a.pincode}
        </address>
        <div class="bl-actions">
          <a class="btn btn--primary" href={directionsUrl} target="_blank" rel="noopener"><Icon name="pin" size={18} />Get directions</a>
          <a class="btn btn--ghost bl-ghost" href={openMapUrl} target="_blank" rel="noopener">Open in Google Maps <Icon name="external" size={16} /></a>
        </div>
      </div>
      <LocationMap ratio="16 / 10" />
    </div>
  </section>

  <Faq eyebrow={`${r.place} FAQ`} title={r.faqTitle} faqs={faqs} />

  <section class="section--tight bl-also">
    <div class="wrap">
      <p>Also: {others.map((o, i) => <>{i > 0 && ' · '}<a href={url(regionHref(o.slug))}>{o.h1}</a></>)} · <a href={url('/build/')}>Electric panel builder (online)</a></p>
    </div>
  </section>
</Base>

<style>
  .bl-also { border-top: 1px solid var(--line); font-size: 14.5px; color: var(--muted); }
  .bl-also a { color: var(--action); font-weight: 600; }
  .bl-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 16px; }
  .bl-trust { display: flex; flex-wrap: wrap; gap: 6px 18px; margin: 14px 0 0; padding: 0; list-style: none; color: #dfe5f2; font-size: 14px; }
  .bl-trust li { display: flex; align-items: center; gap: 6px; }
  .bl-trust :global(svg) { color: var(--live); }
  .bl-h2 { margin: 8px 0 14px; font-size: clamp(22px, 2.6vw, 30px); }
  .bl-types { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); gap: 12px; margin: 0; padding: 0; list-style: none; }
  .bl-types li { padding: 14px 16px; border: 1px solid var(--line); border-radius: 12px; background: var(--white); }
  .bl-types a { display: inline-flex; align-items: center; gap: 6px; color: var(--navy-700); }
  .bl-types a:hover { color: var(--action); }
  .bl-types p { margin-top: 6px; color: var(--ink-2); font-size: 14.5px; line-height: 1.55; }
  .bl-paper { background: var(--paper); border-block: 1px solid var(--line); }
  .bl-two { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(20px, 4vw, 48px); align-items: start; }
  .bl-chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; padding: 0; list-style: none; }
  .bl-chips li { padding: 6px 12px; border: 1px solid var(--line); border-radius: 999px; background: var(--white); font-size: 14px; color: var(--ink-2); }
  .bl-list { display: grid; gap: 8px; margin: 0; padding: 0; list-style: none; }
  .bl-list li { display: flex; gap: 10px; align-items: flex-start; color: var(--ink-2); font-size: 15.5px; line-height: 1.5; }
  .bl-list :global(svg) { flex: none; margin-top: 3px; color: var(--action); }
  .bl-addr { font-style: normal; color: var(--ink-2); font-size: 16px; line-height: 1.6; }
  .bl-ghost { color: var(--ink); border-color: var(--line-2); }
  @media (max-width: 900px) { .bl-two { grid-template-columns: minmax(0, 1fr); } }
</style>
