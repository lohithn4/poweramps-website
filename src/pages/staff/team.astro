---
import Base from '../../layouts/Base.astro';
import StaffNav from '../../components/StaffNav.astro';
---
<Base title="Team & clients" noindex>
  <section class="portal">
    <div class="wrap">
      <div class="portal-head">
        <div><h1>Team & clients</h1><p>Manage who can access the staff portal. Admins can change anyone else's role.</p></div>
        <StaffNav active="team" />
      </div>
      <div class="pgrid">
        <div class="pstack">
          <div class="pcard">
            <div class="pcard__h"><h2>Staff</h2></div>
            <div data-staff><div class="skeleton"></div></div>
          </div>
          <div class="pcard">
            <div class="pcard__h"><h2>Registered clients</h2></div>
            <div data-clients><div class="skeleton"></div></div>
          </div>
        </div>
        <div class="pcard" data-invite-card hidden>
          <div class="pcard__h"><h2>Add a staff member or admin</h2></div>
          <form class="pform" data-invite novalidate>
            <label class="field"><span class="flabel">Name</span><input class="input" name="name" required /></label>
            <label class="field"><span class="flabel">Email</span><input class="input" type="email" name="email" required /></label>
            <label class="field"><span class="flabel">Access</span><select class="input" name="role"><option value="staff">Staff: manage requests & orders</option><option value="admin">Admin: also manage team</option></select></label>
            <p class="form-error" data-error hidden></p>
            <button class="btn btn--primary" type="submit">Send invitation</button>
            <p style="font-size:13px;color:var(--muted)">They'll get an email to set their password. They can also sign in with Google using the same email.</p>
          </form>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>.flabel { font-family: var(--font-mono); font-size: 12px; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }</style>
<style is:global>.input.input--sm { min-height: 36px; padding: 6px 10px; font-size: 14px; width: auto; min-width: 110px; }</style>

<script>
  import { api, requireAuth, type Me } from '../../scripts/api';
  import { $, bindForm, esc, fmtDate, toast } from '../../scripts/ui';

  let me: Me;
  async function load() {
    const [{ users: staff }, { users: clients }] = await Promise.all([api('/staff/users'), api('/staff/users?role=client')]);
    const isAdmin = me.role === 'admin';
    // Admins can change anyone's role except their own: client ↔ staff ↔ admin.
    const roleCell = (u: any) => isAdmin && u.id !== me.id
      ? `<select class="input input--sm" data-role="${u.id}" data-was="${u.role}" aria-label="Role for ${esc(u.name)}">${[['client', 'Client'], ['staff', 'Staff'], ['admin', 'Admin']].map(([v, l]) => `<option value="${v}"${u.role === v ? ' selected' : ''}>${l}</option>`).join('')}</select>`
      : `<span class="badge badge--${u.role === 'admin' ? 'red' : 'blue'}">${u.role}</span>`;
    $('[data-staff]').innerHTML = `<div class="ptable-wrap"><table class="ptable"><thead><tr><th>Name</th><th>Role</th><th>Status</th>${isAdmin ? '<th></th>' : ''}</tr></thead><tbody>
      ${staff.map((u: any) => `<tr><td>${esc(u.name)}<span class="sub">${esc(u.email)}</span></td>
        <td>${roleCell(u)}</td>
        <td>${u.active ? '<span class="badge badge--green">Active</span>' : '<span class="badge badge--muted">Disabled</span>'}</td>
        ${isAdmin ? `<td>${u.id === me.id ? '<span class="sub">You</span>' : `<button class="btn btn--ghost btn--sm" data-toggle="${u.id}" data-active="${u.active}">${u.active ? 'Disable' : 'Enable'}</button>`}</td>` : ''}</tr>`).join('')}
      </tbody></table></div>`;
    $('[data-clients]').innerHTML = clients.length ? `<div class="ptable-wrap"><table class="ptable"><thead><tr><th>Client</th><th>Phone</th><th>Requests</th><th>Joined</th>${isAdmin ? '<th>Role</th>' : ''}</tr></thead><tbody>
      ${clients.map((u: any) => `<tr><td>${esc(u.name)}<span class="sub">${esc(u.company ?? '')} ${esc(u.email)}</span></td><td>${esc(u.phone ?? '—')}</td><td>${u.requests}</td><td>${fmtDate(u.created_at)}</td>${isAdmin ? `<td>${roleCell(u)}</td>` : ''}</tr>`).join('')}
      </tbody></table></div>` : '<div class="pempty">No registered clients yet.</div>';
    document.querySelectorAll<HTMLSelectElement>('[data-role]').forEach((sel) => sel.addEventListener('change', async () => {
      const name = sel.closest('tr')?.querySelector('td')?.firstChild?.textContent ?? 'this person';
      const what = sel.value === 'admin' ? 'an ADMIN (full access, including managing the team and settings)' : sel.value === 'staff' ? 'STAFF (requests, orders and accounts)' : 'a CLIENT (no staff access)';
      if (!confirm(`Make ${name} ${what}?`)) { sel.value = sel.dataset.was!; return; }
      try { await api(`/staff/users/${sel.dataset.role}`, { method: 'PATCH', body: { role: sel.value } }); toast(`${name} is now ${sel.value}`); load(); }
      catch (e: any) { sel.value = sel.dataset.was!; toast(e.message, 'err'); }
    }));
    $('[data-staff]').querySelectorAll<HTMLButtonElement>('[data-toggle]').forEach((b) => b.addEventListener('click', async () => {
      const active = b.dataset.active === '1';
      if (!confirm(`${active ? 'Disable' : 'Enable'} this staff account?`)) return;
      try { await api(`/staff/users/${b.dataset.toggle}`, { method: 'PATCH', body: { active: !active } }); toast('Updated'); load(); } catch (e: any) { toast(e.message, 'err'); }
    }));
  }

  bindForm($('[data-invite]'), async (d) => { await api('/staff/users', { body: d }); toast(`Invitation sent to ${d.email}`); ($('[data-invite]') as HTMLFormElement).reset(); load(); });

  requireAuth('staff').then((u) => { me = u; $('[data-invite-card]').hidden = u.role !== 'admin'; return load(); })
    .catch((e) => { if (e.message !== 'redirecting') $('[data-staff]').innerHTML = `<p class="form-error">${esc(e.message)}</p>`; });
</script>
