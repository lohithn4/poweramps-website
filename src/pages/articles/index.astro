---
import Base from '../../layouts/Base.astro';
import StoryCard from '../../components/StoryCard.astro';
import site from '../../data/site.json';
import { getArticles, readMinutes, topicTypes } from '../../lib/content';
import { url } from '../../lib/url';

const articles = await getArticles();
const brand: string = (site as any).shortName || site.name;
const abs = (p: string) => new URL(url(p), Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: abs('/') },
      { '@type': 'ListItem', position: 2, name: 'Articles', item: abs('/articles/') },
    ] },
    { '@type': 'Blog', '@id': abs('/articles/#blog'), name: `${brand} articles`, url: abs('/articles/'), publisher: { '@id': abs('/#business') },
      blogPost: articles.map((a) => ({ '@type': 'BlogPosting', headline: a.data.title, url: abs(`/articles/${a.id}/`), datePublished: a.data.date.toISOString() })) },
  ],
};
---
<Base
  title="Electrical Panel Guides & Articles"
  description={`Practical guides on electrical panels from ${brand}, ${site.address.city}: MCC, PCC, AMF, DG synchronization and more, plus how to build a custom electric panel online.`}
  jsonLd={jsonLd}
  noindex={articles.length === 0}
>
  <section class="page-hero blueprint on-dark">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb"><a href={url('/')}>Home</a><span aria-hidden="true">/</span><span>Articles</span></nav>
      <h1>Electrical panel guides</h1>
      <p>Straight answers from our engineers on choosing, specifying and buying LT panels in India.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      {articles.length > 0 ? (
        <div class="sgrid">
          {articles.map((a) => (
            <StoryCard
              href={`/articles/${a.id}/`}
              title={a.data.title}
              text={a.data.description}
              image={a.data.image}
              imageAlt={a.data.imageAlt ?? a.data.title}
              kicker={[topicTypes(a.data.topics)[0]?.short, `${readMinutes(a.body)} min read`].filter(Boolean).join(' · ')}
            />
          ))}
        </div>
      ) : (
        <p class="empty">Articles are on the way.</p>
      )}
      <p class="feed"><a href={url('/articles/rss.xml')}>RSS feed</a></p>
    </div>
  </section>
</Base>

<style>
  .sgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 16px; }
  .empty { color: var(--muted); }
  .feed { margin-top: 18px; font-size: 13.5px; }
  .feed a { color: var(--muted); }
</style>
