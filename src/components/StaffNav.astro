---
import { url } from '../lib/url';
export type StaffTab = 'requests' | 'accounts' | 'docs' | 'payments' | 'parties' | 'items' | 'reports' | 'tally' | 'feedback' | 'team' | 'settings';
interface Props { active: StaffTab }
const { active } = Astro.props;
const tabs: [StaffTab, string, string][] = [
  ['requests', 'Requests', '/staff/'],
  ['accounts', 'Accounts', '/staff/accounts/'],
  ['docs', 'Quotes & invoices', '/staff/docs/'],
  ['payments', 'Payments', '/staff/payments/'],
  ['parties', 'Parties', '/staff/parties/'],
  ['items', 'Items', '/staff/items/'],
  ['reports', 'GST & reports', '/staff/reports/'],
  ['tally', 'Tally', '/staff/tally/'],
  ['feedback', 'Feedback', '/staff/feedback/'],
  ['team', 'Team', '/staff/team/'],
  ['settings', 'Settings', '/staff/settings/'],
];
---
<nav class="snav" aria-label="Staff sections">
  {tabs.map(([k, label, href]) => <a href={url(href)} class:list={{ 'is-active': active === k }} aria-current={active === k ? 'page' : undefined}>{label}</a>)}
  <span class="snav__sep" aria-hidden="true"></span>
  <a href={url('/admin/')} target="_blank" rel="noopener">Website ↗</a>
  <a href={url('/portal/')}>My account</a>
  <button type="button" class="snav__out" data-staff-signout>Sign out</button>
</nav>

<script>
  document.querySelector<HTMLButtonElement>('[data-staff-signout]')?.addEventListener('click', async (e) => {
    (e.currentTarget as HTMLButtonElement).disabled = true;
    const { logout } = await import('../scripts/api');
    await logout();
  });
</script>
