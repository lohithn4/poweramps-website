---
/** Google / Microsoft / LinkedIn sign-in buttons. Only providers configured on the API are shown. */
interface Props { mode?: 'login' | 'register' }
const { mode = 'login' } = Astro.props;
---
<div class="social-wrap" data-social data-mode={mode} hidden>
  <div class="social" data-social-list></div>
  <div class="divider">or with email</div>
</div>

<template id="social-icons">
  <svg data-icon="google" viewBox="0 0 48 48" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/><path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/></svg>
  <svg data-icon="microsoft" viewBox="0 0 24 24" aria-hidden="true"><rect x="1" y="1" width="10" height="10" fill="#F25022"/><rect x="13" y="1" width="10" height="10" fill="#7FBA00"/><rect x="1" y="13" width="10" height="10" fill="#00A4EF"/><rect x="13" y="13" width="10" height="10" fill="#FFB900"/></svg>
  <svg data-icon="linkedin" viewBox="0 0 24 24" aria-hidden="true"><rect width="24" height="24" rx="4" fill="#0A66C2"/><path fill="#fff" d="M7.1 9.4H4.6V19h2.5V9.4zM5.9 5a1.45 1.45 0 1 0 0 2.9 1.45 1.45 0 0 0 0-2.9zM19.4 13.6c0-2.6-1.4-4.4-3.8-4.4-1.2 0-2 .6-2.4 1.2V9.4h-2.4V19h2.5v-4.8c0-1.3.4-2.4 1.7-2.4 1.3 0 1.9 1 1.9 2.4V19h2.5v-5.4z"/></svg>
  <svg data-icon="dev" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10" fill="#667085"/><path d="M8 12h8" stroke="#fff" stroke-width="2"/></svg>
</template>

<script>
  import { API_URL, api } from '../scripts/api';
  import { esc, qs } from '../scripts/ui';

  const box = document.querySelector<HTMLElement>('[data-social]');
  if (box) {
    const list = box.querySelector<HTMLElement>('[data-social-list]')!;
    const icons = document.getElementById('social-icons') as HTMLTemplateElement;
    const verb = box.dataset.mode === 'register' ? 'Sign up' : 'Continue';
    api<{ providers: { id: string; label: string }[] }>('/auth/providers')
      .then(({ providers }) => {
        if (!providers.length) return;
        const next = qs('next') ?? '/portal/';
        list.innerHTML = providers.map((p) => {
          const icon = icons.content.querySelector(`[data-icon="${p.id}"]`)?.outerHTML ?? '';
          return `<a class="social__btn" href="${API_URL}/auth/oauth/${p.id}/start?next=${encodeURIComponent(next)}">${icon}<span>${verb} with ${esc(p.label)}</span></a>`;
        }).join('');
        box.hidden = false;
      })
      .catch(() => {});
  }
</script>
