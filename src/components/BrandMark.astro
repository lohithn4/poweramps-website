---
/**
 * The brand symbol. Uses brand.logoImage from site.json if set (any square logo),
 * otherwise the 2×2 square mark in the brand colours.
 */
import site from '../data/site.json';
import { url } from '../lib/url';

interface Props { size?: number; class?: string }
const { size = 40, class: className } = Astro.props;
const img = site.brand.logoImage;
---
{img ? (
  <img class={className} src={url(img)} alt="" width={size} height={size} style={`width:${size}px;height:${size}px;object-fit:contain`} />
) : (
  <svg class={className} viewBox="0 0 40 40" width={size} height={size} aria-hidden="true" style="shape-rendering:crispEdges">
    <rect x="0" y="0" width="18.5" height="18.5" fill="var(--brand-primary)" />
    <rect x="21.5" y="0" width="18.5" height="18.5" fill="var(--brand-accent)" />
    <rect x="0" y="21.5" width="18.5" height="18.5" fill="var(--brand-accent)" />
    <rect x="21.5" y="21.5" width="18.5" height="18.5" fill="var(--brand-primary)" />
  </svg>
)}
