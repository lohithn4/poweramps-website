---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import site from '../data/site.json';
import { url, isActive } from '../lib/url';
import { openMapUrl } from '../lib/location';
import { getClients } from '../lib/clients';
import { getTestimonials } from '../lib/testimonials';

const hasClients = (await getClients()).length > 0 || (await getTestimonials()).length > 0;
const nav = [
  { href: '/panels', label: 'Panels' },
  { href: '/build', label: 'Build a panel' },
  ...(hasClients ? [{ href: '/clients', label: 'Clients' }] : []),
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
const path = Astro.url.pathname;
---
<div class="masthead" data-masthead>
<div class="topbar">
  <div class="wrap topbar__inner">
    <span class="topbar__item topbar__gst">
      <span class="gst-badge"><Icon name="shield" size={13} />GST verified</span>
      <button type="button" class="gstin" data-copy={site.gst} title="Click to copy GSTIN" aria-label={`GSTIN ${site.gst}, click to copy`}>
        <span class="gstin__label">GSTIN</span>
        <span class="gstin__num">{site.gst}</span>
        <span class="gstin__done" aria-live="polite"></span>
      </button>
      <span class="topbar__since">· Manufacturer since {site.established}</span>
    </span>
    <span class="topbar__right">
      <a class="topbar__item topbar__loc" href={openMapUrl} target="_blank" rel="noopener" title="Open our location in Google Maps">
        <Icon name="pin" size={14} />{site.address.locality && <span class="topbar__loc-long">{site.address.locality}, </span>}{site.address.city}
      </a>
      {site.phone && (
        <a class="topbar__item topbar__extra topbar__phone" href={`tel:${site.phone.replace(/\s/g, '')}`}
          aria-label={site.contactName ? `Call ${site.contactName}${site.contactRole ? `, ${site.contactRole}` : ''}: ${site.phone}` : `Call ${site.phone}`}>
          <Icon name="phone" size={14} />{site.phone}
          {site.contactName && <span class="topbar__who" aria-hidden="true">{site.contactName}{site.contactRole && <small>{site.contactRole}</small>}</span>}
        </a>
      )}
      {site.email && <a class="topbar__item topbar__extra" href={`mailto:${site.email}`}><Icon name="mail" size={14} />{site.email}</a>}
    </span>
  </div>
</div>

<header class="header" data-header>
  <div class="wrap header__inner">
    <Logo />

    <nav class="nav" aria-label="Main">
      {nav.map((item) => (
        <a href={url(item.href)} class:list={['nav__link', { 'has-tip': item.href === '/build', 'is-active': !item.href.includes('#') && isActive(path, item.href) }]}>
          {item.label}{item.href === '/build' && <><span class="nav__new">New</span><span class="tip" role="tooltip"><strong>Build your own panel online</strong> · choose every component to suit your site</span></>}
        </a>
      ))}
    </nav>

    <div class="header__cta">
      <div class="acctm" data-acctm>
        <a class="acct" href={url('/portal/login/')} data-acct aria-haspopup="menu" aria-expanded="false"><Icon name="user" size={18} /><span data-acct-label>Sign in</span></a>
        <div class="acctm__menu" role="menu" data-acct-menu hidden>
          <a role="menuitem" href={url('/portal/')}><Icon name="user" size={16} />My account</a>
          <a role="menuitem" href={url('/portal/#builds')}><Icon name="layers" size={16} />My panel builds</a>
          <a role="menuitem" href={url('/staff/')} data-staff-only hidden><Icon name="cog" size={16} />Staff dashboard</a>
          <button role="menuitem" type="button" data-signout><Icon name="arrow" size={16} />Sign out</button>
        </div>
      </div>
      <a class="btn btn--primary btn--sm has-tip tip-end" href={url("/build/")}><Icon name="layers" size={16} />Build your panel<span class="tip" role="tooltip"><strong>Build your own panel online</strong> · choose every component to suit your site</span></a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-nav" data-menu-btn>
        <span class="sr-only">Menu</span>
        <Icon name="menu" size={24} class="i-open" />
        <Icon name="close" size={24} class="i-close" />
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="mnav" aria-label="Mobile" data-mnav hidden>
    <div class="wrap mnav__inner">
      {nav.map((item) => <a href={url(item.href)} class="mnav__link">{item.label} <Icon name="arrow" size={18} /></a>)}
      <a href={url('/portal/login/')} class="mnav__link" data-acct>Client / staff sign in <Icon name="user" size={18} /></a>
      <button type="button" class="mnav__link mnav__signout" data-signout hidden>Sign out <Icon name="arrow" size={18} /></button>
      <a class="btn btn--primary btn--block" href={url('/build/')}>Build a panel &amp; get a quote</a>
    </div>
  </nav>
</header>
</div>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
  const nav = document.querySelector<HTMLElement>('[data-mnav]');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    if (nav) nav.hidden = open;
  });
  nav?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      btn?.setAttribute('aria-expanded', 'false');
      nav.hidden = true;
    }),
  );
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => {
    const done = b.querySelector<HTMLElement>('.gstin__done');
    b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.copy ?? '');
        b.classList.add('is-copied');
        if (done) done.textContent = 'Copied';
        setTimeout(() => { b.classList.remove('is-copied'); if (done) done.textContent = ''; }, 1600);
      } catch {}
    });
  });

  // Signed in (flag set on login): "My account" opens a menu with Sign out; mobile menu gets Sign out.
  let signedIn = false, role = '';
  try { signedIn = localStorage.getItem('portal_signed_in') === '1'; role = localStorage.getItem('portal_role') ?? ''; } catch {}
  if (signedIn) {
    document.querySelectorAll<HTMLAnchorElement>('[data-acct]').forEach((a) => {
      a.href = a.href.replace('portal/login/', 'portal/');
      const l = a.querySelector('[data-acct-label]');
      if (l) l.textContent = 'My account';
      else a.firstChild!.textContent = 'My account ';
    });
    document.querySelectorAll<HTMLElement>('[data-signout]').forEach((b) => (b.hidden = false));
    if (role === 'staff' || role === 'admin') document.querySelectorAll<HTMLElement>('[data-staff-only]').forEach((e) => (e.hidden = false));

    const wrap = document.querySelector<HTMLElement>('[data-acctm]');
    const trigger = wrap?.querySelector<HTMLAnchorElement>('[data-acct]');
    const menu = wrap?.querySelector<HTMLElement>('[data-acct-menu]');
    const setOpen = (open: boolean) => { if (menu && trigger) { menu.hidden = !open; trigger.setAttribute('aria-expanded', String(open)); } };
    trigger?.addEventListener('click', (e) => { e.preventDefault(); setOpen(!!menu?.hidden); });
    document.addEventListener('click', (e) => { if (wrap && !wrap.contains(e.target as Node)) setOpen(false); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
  }
  document.querySelectorAll<HTMLButtonElement>('[data-signout]').forEach((b) => b.addEventListener('click', async () => {
    b.disabled = true;
    const { logout } = await import('../scripts/api');
    await logout();
  }));

  const header = document.querySelector('[data-masthead]');
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .topbar {
    --topbar-red: color-mix(in srgb, var(--red) 78%, white); /* readable red on the dark bar */
    background: var(--navy-950);
    color: #aab4cc;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
  }
  .topbar__inner { display: flex; justify-content: space-between; align-items: center; gap: 16px; min-height: 32px; }
  .topbar__right { display: flex; gap: 22px; }
  .topbar__item { display: inline-flex; align-items: center; gap: 7px; white-space: nowrap; }
  a.topbar__item:hover { color: #fff; }
  /* Contact person shown when hovering / focusing the phone number */
  .topbar__phone { position: relative; }
  .topbar__who {
    position: absolute; top: calc(100% + 10px); right: 0; z-index: 1000;
    display: grid; gap: 2px; padding: 9px 12px; border-radius: 10px;
    background: var(--white); color: var(--ink); box-shadow: var(--shadow);
    font-family: var(--font-sans, inherit); font-size: 14px; font-weight: 600; letter-spacing: 0; white-space: nowrap;
    opacity: 0; visibility: hidden; transform: translateY(-4px); transition: opacity .15s, transform .15s, visibility .15s;
    pointer-events: none;
  }
  .topbar__who::before { content: ''; position: absolute; top: -6px; right: 18px; border: 6px solid transparent; border-top: 0; border-bottom-color: var(--white); }
  .topbar__who small { font-size: 12px; font-weight: 500; color: var(--muted); }
  .topbar__phone:hover .topbar__who, .topbar__phone:focus-visible .topbar__who { opacity: 1; visibility: visible; transform: none; }
  .topbar__gst { gap: 10px; }
  .gst-badge {
    display: inline-flex; align-items: center; gap: 5px;
    padding: 2px 8px 2px 6px;
    border-radius: 999px;
    background: rgb(34 197 94 / 14%);
    border: 1px solid rgb(34 197 94 / 35%);
    color: #4ade80;
    font-size: 11px; font-weight: 600; letter-spacing: 0.03em;
  }
  .gstin {
    position: relative;
    display: inline-flex; align-items: center; gap: 6px;
    padding: 0; border: 0; background: none; cursor: copy;
    font: inherit; color: #dfe5f2;
  }
  .gstin__label { color: #8d98b3; }
  .gstin__num { color: #fff; font-weight: 600; letter-spacing: 0.04em; }
  .gstin:hover .gstin__num { text-decoration: underline; text-underline-offset: 3px; }
  .gstin__done {
    position: absolute; left: 100%; margin-left: 8px;
    color: #4ade80; font-size: 11px; white-space: nowrap;
  }
  .gstin.is-copied .gstin__num { color: #4ade80; }
  .topbar__since { color: #8d98b3; }
  .topbar__loc { color: #dfe5f2; }
  .topbar__loc :global(svg) { color: var(--topbar-red); transform-origin: 50% 100%; animation: pin-hop 2.8s ease-in-out infinite; }
  .topbar__loc { position: relative; }
  .topbar__loc::before {
    content: ''; position: absolute; left: 7px; top: 50%; width: 6px; height: 6px; margin: -3px 0 0 -3px; border-radius: 50%;
    background: var(--topbar-red); opacity: 0; pointer-events: none; animation: pin-ring 2.8s ease-out infinite;
  }
  .topbar__loc:hover :global(svg) { color: #fff; }
  @keyframes pin-hop { 0%, 60%, 100% { transform: none; } 70% { transform: translateY(-3px); } 80% { transform: none; } 88% { transform: translateY(-1.5px); } }
  @keyframes pin-ring { 0%, 62% { opacity: 0; transform: scale(.4); } 70% { opacity: .55; } 100% { opacity: 0; transform: scale(3.2); } }
  /* Phone icon: red, with a short ring wiggle that runs between the pin hops */
  .topbar__phone > :global(svg) { color: var(--topbar-red); transform-origin: 50% 50%; animation: phone-ring 2.8s ease-in-out 1.4s infinite; }
  .topbar__phone:hover > :global(svg) { color: #fff; }
  @keyframes phone-ring { 0%, 64%, 100% { transform: none; } 68% { transform: rotate(-14deg); } 72% { transform: rotate(12deg); } 76% { transform: rotate(-10deg); } 80% { transform: rotate(6deg); } 84% { transform: none; } }
  @media (prefers-reduced-motion: reduce) { .topbar__loc :global(svg), .topbar__loc::before, .topbar__phone > :global(svg) { animation: none; } }
  .topbar__loc:hover { text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 1100px) {
    .topbar__extra { display: none; }
  }
  @media (max-width: 900px) {
    .topbar__since { display: none; }
  }
  @media (max-width: 720px) {
    .topbar__loc-long { display: none; }
    .topbar__inner { gap: 8px; }
    .topbar__gst { gap: 8px; }
  }
  @media (max-width: 400px) {
    .gstin__label { display: none; }
    .gst-badge { padding: 2px 6px; }
  }
  @media (max-width: 359px) {
    .topbar__loc { display: none; }
    .header__inner { gap: 12px; }
  }

  .masthead { position: sticky; top: 0; z-index: 50; }
  .masthead.is-scrolled { box-shadow: 0 6px 24px -12px rgb(13 22 38 / 18%); }
  .header {
    position: relative;
    background: rgb(255 255 255 / 92%);
    backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid var(--line);
    transition: box-shadow .25s;
  }
  .header__inner { display: flex; align-items: center; justify-content: space-between; gap: 24px; min-height: 62px; }

  .nav { display: flex; gap: 6px; }
  .nav__link {
    position: relative;
    padding: 10px 14px;
    font-weight: 500;
    font-size: 15px;
    color: var(--ink-2);
    border-radius: 6px;
    transition: color .2s, background .2s;
  }
  .nav__link:hover { color: var(--ink); background: var(--paper); }
  .nav__new { display: inline-block; margin-left: 6px; padding: 2px 6px; border-radius: 6px; background: var(--red); color: #fff; font-size: 10.5px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; vertical-align: 2px; }
  .nav__link.is-active { color: var(--navy-700); }
  .nav__link.is-active::after {
    content: '';
    position: absolute;
    left: 14px; right: 14px; bottom: -15px;
    height: 2px;
    background: var(--action);
  }

  .header__cta { display: flex; align-items: center; gap: 10px; }
  .acct { display: inline-flex; align-items: center; gap: 7px; padding: 8px 12px; border-radius: 8px; font-size: 14.5px; font-weight: 500; color: var(--ink-2); }
  .acct:hover { background: var(--paper); color: var(--ink); }
  .acctm { position: relative; }
  .acctm__menu { position: absolute; top: calc(100% + 8px); right: 0; z-index: 1000; min-width: 220px; padding: 6px; border: 1px solid var(--line); border-radius: 12px; background: var(--white); box-shadow: var(--shadow); display: grid; }
  .acctm__menu[hidden] { display: none; }
  .acctm__menu a, .acctm__menu button { display: flex; align-items: center; gap: 10px; width: 100%; padding: 10px 12px; border: 0; border-radius: 8px; background: none; font: inherit; font-size: 14.5px; font-weight: 500; color: var(--ink-2); text-align: left; cursor: pointer; }
  .acctm__menu a:hover, .acctm__menu button:hover, .acctm__menu a:focus-visible, .acctm__menu button:focus-visible { background: var(--paper); color: var(--ink); }
  .acctm__menu a[hidden] { display: none; }
  .acctm__menu button { margin-top: 4px; border-top: 1px solid var(--line); border-radius: 0 0 8px 8px; color: var(--red); }
  .mnav__signout { width: 100%; border: 0; background: none; font: inherit; text-align: left; cursor: pointer; color: var(--red); }
  .mnav__signout[hidden] { display: none; }
  @media (max-width: 880px) { .acct span { display: none; } .acct { padding: 10px; border: 1px solid var(--line); } }
  .menu-btn {
    display: none;
    width: 44px; height: 44px;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--white);
    cursor: pointer;
  }
  .menu-btn :global(.i-close) { display: none; }
  .menu-btn[aria-expanded='true'] :global(.i-open) { display: none; }
  .menu-btn[aria-expanded='true'] :global(.i-close) { display: block; }

  .mnav { border-top: 1px solid var(--line); background: var(--white); max-height: calc(100vh - var(--masthead-h)); max-height: calc(100dvh - var(--masthead-h)); overflow-y: auto; overscroll-behavior: contain; }
  .mnav__inner { display: grid; gap: 4px; padding-block: 12px 20px; }
  .mnav__link {
    display: flex; justify-content: space-between; align-items: center;
    padding: 14px 4px;
    font-size: 18px; font-weight: 600;
    border-bottom: 1px solid var(--line);
  }
  .mnav .btn { margin-top: 12px; }

  @media (max-width: 880px) {
    .nav { display: none; }
    .menu-btn { display: grid; }
  }
  @media (max-width: 420px) {
    .header__cta .btn { display: none; }
  }
</style>
