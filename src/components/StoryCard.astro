---
/** Card for an article or a case study (project). */
import Icon from './Icon.astro';
import { url } from '../lib/url';

interface Props {
  href: string;
  title: string;
  text: string;
  image?: string;
  imageAlt?: string;
  kicker?: string; // small line above the title, e.g. "Guide · 6 min read" or "Pharma plant · Bengaluru"
  cta?: string;
}
const { href, title, text, image, imageAlt = '', kicker, cta = 'Read' } = Astro.props;
---
<article class="scard">
  <a class="scard__link" href={url(href)}>
    {image && (
      <div class="scard__media"><img src={url(image)} alt={imageAlt} width="480" height="300" loading="lazy" decoding="async" /></div>
    )}
    <div class="scard__body">
      {kicker && <span class="scard__kicker mono">{kicker}</span>}
      <h3 class="scard__title">{title}</h3>
      <p class="scard__text">{text}</p>
      <span class="scard__cta">{cta} <Icon name="arrow" size={15} /></span>
    </div>
  </a>
</article>

<style>
  .scard { background: var(--white); border: 1px solid var(--line); border-radius: var(--radius-lg); overflow: hidden; transition: transform .35s var(--ease), box-shadow .35s var(--ease), border-color .35s; }
  .scard:hover { transform: translateY(-3px); box-shadow: var(--shadow); border-color: var(--line-2); }
  .scard__link { display: flex; flex-direction: column; height: 100%; color: inherit; }
  .scard__media { aspect-ratio: 16 / 10; background: radial-gradient(120% 80% at 50% 0%, #fff 0%, var(--plate) 100%); border-bottom: 1px solid var(--line); overflow: hidden; }
  .scard__media img { width: 100%; height: 100%; object-fit: contain; padding: 12px; mix-blend-mode: multiply; }
  .scard__body { display: flex; flex-direction: column; gap: 6px; padding: 14px 16px 16px; flex: 1; }
  .scard__kicker { font-size: 11.5px; letter-spacing: .08em; text-transform: uppercase; color: var(--action); }
  .scard__title { font-size: 18px; line-height: 1.3; color: var(--ink); }
  .scard__text { color: var(--ink-2); font-size: 14.5px; line-height: 1.55; }
  .scard__cta { margin-top: auto; padding-top: 6px; display: inline-flex; align-items: center; gap: 6px; font-weight: 600; font-size: 14.5px; color: var(--action); }
</style>
