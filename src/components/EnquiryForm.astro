---
import Icon from './Icon.astro';
import site from '../data/site.json';
import { getPanels } from '../lib/panels';

/**
 * Enquiry form for a static site.
 * - If `formEndpoint` is set in src/data/site.json (e.g. a Formspree URL),
 *   the form POSTs there and you receive the enquiry by email.
 * - Otherwise it opens the visitor's email app (if `email` is set),
 *   WhatsApp (if `whatsapp` is set) or the IndiaMART enquiry page,
 *   with the message pre-filled.
 */
const panels = await getPanels();
const endpoint = site.formEndpoint;
const fallback = site.email ? 'email' : site.whatsapp ? 'whatsapp' : 'indiamart';
---
<form
  class="form"
  method="post"
  action={endpoint || undefined}
  data-enquiry
  data-mode={endpoint ? 'endpoint' : fallback}
  data-email={site.email}
  data-whatsapp={site.whatsapp.replace(/\D/g, '')}
  data-indiamart={`${site.indiamart.replace(/\/$/, '')}/enquiry.html`}
  data-company={site.name}
>
  <div class="form__row">
    <div class="field">
      <label for="f-name">Your name *</label>
      <input class="input" id="f-name" name="name" required autocomplete="name" />
    </div>
    <div class="field">
      <label for="f-company">Company</label>
      <input class="input" id="f-company" name="company" autocomplete="organization" />
    </div>
  </div>
  <div class="form__row">
    <div class="field">
      <label for="f-phone">Phone *</label>
      <input class="input" id="f-phone" name="phone" type="tel" required autocomplete="tel" />
    </div>
    <div class="field">
      <label for="f-email">Email</label>
      <input class="input" id="f-email" name="email" type="email" autocomplete="email" />
    </div>
  </div>
  <div class="field">
    <label for="f-panel">Panel of interest</label>
    <select class="input" id="f-panel" name="panel" data-panel>
      <option value="">General enquiry / custom panel</option>
      {panels.map((p) => <option value={p.data.title}>{p.data.title}</option>)}
    </select>
  </div>
  <div class="field">
    <label for="f-msg">Requirement *</label>
    <textarea class="input" id="f-msg" name="message" required placeholder="Ratings, quantity, site location, timeline…"></textarea>
  </div>
  <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />
  <button class="btn btn--primary btn--block" type="submit">
    Send enquiry <Icon name="arrow" size={18} />
  </button>
  <p class="form__note">
    {endpoint
      ? 'We usually reply within one working day.'
      : fallback === 'email'
        ? 'Opens your email app with the enquiry filled in.'
        : fallback === 'whatsapp'
          ? 'Opens WhatsApp with the enquiry filled in.'
          : 'Your enquiry is copied, then our IndiaMART enquiry page opens.'}
  </p>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-enquiry]').forEach((form) => {
    const fromQuery = new URLSearchParams(location.search).get('panel');
    const select = form.querySelector<HTMLSelectElement>('[data-panel]');
    if (fromQuery && select) {
      if (![...select.options].some((o) => o.value === fromQuery)) select.add(new Option(fromQuery, fromQuery));
      select.value = fromQuery;
    }

    form.addEventListener('submit', async (e) => {
      const mode = form.dataset.mode;
      if (mode === 'endpoint') return; // normal POST
      e.preventDefault();
      const f = new FormData(form);
      const lines = [
        `Enquiry for ${form.dataset.company}`,
        '',
        `Name: ${f.get('name')}`,
        f.get('company') ? `Company: ${f.get('company')}` : '',
        `Phone: ${f.get('phone')}`,
        f.get('email') ? `Email: ${f.get('email')}` : '',
        f.get('panel') ? `Panel: ${f.get('panel')}` : '',
        '',
        String(f.get('message') ?? ''),
      ].filter((l, i, arr) => l !== '' || arr[i - 1] !== '');
      const body = lines.join('\n');
      const subject = `Enquiry: ${f.get('panel') || 'Electrical panel'}`;

      if (mode === 'email') {
        location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      } else if (mode === 'whatsapp') {
        window.open(`https://wa.me/${form.dataset.whatsapp}?text=${encodeURIComponent(body)}`, '_blank', 'noopener');
      } else {
        try { await navigator.clipboard.writeText(body); } catch {}
        window.open(form.dataset.indiamart, '_blank', 'noopener');
      }
    });
  });
</script>

<style>
  .form { display: grid; gap: 16px; }
  .form__row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  @media (max-width: 560px) { .form__row { grid-template-columns: 1fr; } }
  .form__note { font-size: 13px; color: var(--muted); text-align: center; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  select.input { appearance: none; background-image: linear-gradient(45deg, transparent 50%, var(--muted) 50%), linear-gradient(135deg, var(--muted) 50%, transparent 50%); background-position: calc(100% - 20px) 50%, calc(100% - 15px) 50%; background-size: 5px 5px; background-repeat: no-repeat; padding-right: 40px; }
</style>
