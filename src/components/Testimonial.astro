---
import type { Client } from '../lib/clients';
import { initials } from '../lib/clients';
import { url } from '../lib/url';

import type { CardData } from '../lib/testimonials';

interface Props {
  client?: Client;
  data?: CardData;   // approved feedback from the portal
  index?: number;
}
const { client, data, index = 0 } = Astro.props;
const c: CardData = client?.data ?? data!;
---
<figure class="tcard reveal" style={`transition-delay:${Math.min(index, 6) * 60}ms`}>
  <svg class="tcard__q" viewBox="0 0 32 24" aria-hidden="true"><path d="M0 24V14C0 6 4.5 1.3 13.5 0l1.2 3.6C10 5 7.8 7.8 7.6 11.6H13V24H0Zm18 0V14C18 6 22.5 1.3 31.5 0l1.2 3.6C28 5 25.8 7.8 25.6 11.6H31V24H18Z" /></svg>
  <blockquote>{c.quote}</blockquote>
  {c.project && <p class="tcard__project"><span>Supplied</span>{c.project}</p>}
  <figcaption>
    {c.logo ? (
      <img src={url(c.logo)} alt="" loading="lazy" />
    ) : (
      <span class="tcard__mono" aria-hidden="true">{initials(c.name)}</span>
    )}
    <span class="tcard__who">
      {c.person && <strong>{c.person}{c.role && <span>, {c.role}</span>}</strong>}
      <span class="tcard__co">{c.name}{c.city && ` · ${c.city}`}</span>
    </span>
  </figcaption>
</figure>

<style>
  .tcard {
    position: relative;
    display: flex; flex-direction: column; gap: 18px;
    margin: 0;
    padding: 28px;
    background: var(--white);
    border: 1px solid var(--line);
    border-top: 3px solid var(--red);
    border-radius: 0 0 var(--radius-lg) var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }
  .tcard__q { width: 34px; height: 26px; fill: var(--red); opacity: .9; }
  .tcard blockquote { margin: 0; font-size: 17px; line-height: 1.65; color: var(--ink); text-wrap: pretty; }
  .tcard__project {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px;
    font-size: 14px; color: var(--ink-2);
  }
  .tcard__project span {
    font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.1em; text-transform: uppercase;
    padding: 2px 7px; border-radius: 4px; background: var(--paper); color: var(--muted);
  }
  .tcard figcaption {
    display: flex; align-items: center; gap: 12px;
    margin-top: auto; padding-top: 16px;
    border-top: 1px solid var(--line);
  }
  .tcard figcaption img { width: 44px; height: 44px; object-fit: contain; border-radius: 8px; background: var(--paper); padding: 4px; }
  .tcard__mono {
    display: grid; place-items: center; flex: none;
    width: 44px; height: 44px; border-radius: 10px;
    background: linear-gradient(135deg, var(--navy-800), var(--navy-700)); color: #fff;
    font-weight: 700; font-size: 15px;
  }
  .tcard__who { display: grid; gap: 2px; line-height: 1.3; }
  .tcard__who strong { font-size: 15px; }
  .tcard__who strong span { font-weight: 400; color: var(--ink-2); }
  .tcard__co { font-size: 13.5px; color: var(--muted); }
</style>
