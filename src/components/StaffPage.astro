---
/** Layout for staff ERP screens: navigation bar, heading row with actions, content. */
import Base from '../layouts/Base.astro';
import StaffNav, { type StaffTab } from './StaffNav.astro';
interface Props { title: string; active: StaffTab; sub?: string; crumb?: { href: string; label: string } }
const { title, active, sub, crumb } = Astro.props;
---
<Base title={title} noindex>
  <section class="portal staff">
    <div class="wrap">
      <StaffNav active={active} />
      <div class="portal-head">
        <div>
          {crumb && <nav class="crumbs" aria-label="Breadcrumb"><a href={crumb.href}>{crumb.label}</a><span aria-hidden="true">/</span><span data-crumb>{title}</span></nav>}
          <h1 data-title>{title}</h1>
          {sub !== undefined && <p data-sub>{sub}</p>}
        </div>
        <div class="phead-actions"><slot name="actions" /></div>
      </div>
      <slot />
    </div>
  </section>
</Base>
