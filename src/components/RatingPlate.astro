---
import site from '../data/site.json';
interface Props {
  items: { label: string; value: string }[];
  title?: string;
  serial?: string;
  class?: string;
}
const { items, title = 'Rating plate', serial, class: className, ...rest } = Astro.props;
---
<div {...rest} class:list={['plate', className]}>
  <span class="rivet tl" aria-hidden="true"></span>
  <span class="rivet tr" aria-hidden="true"></span>
  <span class="rivet bl" aria-hidden="true"></span>
  <span class="rivet br" aria-hidden="true"></span>
  <div class="plate__head">
    <span><span class="plate__brand">{site.brand.wordmark || site.name} · </span>{title}</span>
    {serial && <span>{serial}</span>}
  </div>
  <dl class="plate__grid">
    {items.map((i) => (
      <div>
        <dt>{i.label}</dt>
        <dd>{i.value}</dd>
      </div>
    ))}
  </dl>
</div>

<style>
  .plate {
    position: relative;
    padding: 18px 22px 20px;
    border-radius: 10px;
    background:
      repeating-linear-gradient(90deg, rgb(255 255 255 / 0%) 0 2px, rgb(255 255 255 / 22%) 2px 3px),
      linear-gradient(160deg, #f4f6f8 0%, #dfe3e8 55%, #cfd5dc 100%);
    border: 1px solid #b9c0ca;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 90%),
      inset 0 -1px 0 rgb(0 0 0 / 8%),
      0 8px 20px -10px rgb(13 22 38 / 35%);
    color: #1f2937;
  }
  .rivet {
    position: absolute;
    width: 9px; height: 9px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #fff 0, #c9ced6 45%, #8d95a1 100%);
    box-shadow: 0 1px 1px rgb(0 0 0 / 25%);
  }
  .tl { top: 8px; left: 8px; } .tr { top: 8px; right: 8px; }
  .bl { bottom: 8px; left: 8px; } .br { bottom: 8px; right: 8px; }

  .plate__head {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 0 8px 10px;
    margin-bottom: 12px;
    border-bottom: 1px solid rgb(31 41 55 / 22%);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--navy-800);
  }
  .plate__head > * { white-space: nowrap; }
  @media (max-width: 520px) {
    .plate__brand { display: none; }
  }
  .plate__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px 18px;
    margin: 0;
    padding: 0 8px;
  }
  .plate__grid dt {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #5b6472;
  }
  .plate__grid dd {
    margin: 2px 0 0;
    font-family: var(--font-mono);
    font-size: 17px;
    font-weight: 600;
    color: #111827;
    text-shadow: 0 1px 0 rgb(255 255 255 / 70%);
  }
</style>
