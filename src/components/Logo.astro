---
import BrandMark from './BrandMark.astro';
import site from '../data/site.json';
import { url } from '../lib/url';

interface Props {
  /** White wordmark for dark backgrounds (footer). */
  light?: boolean;
}
const { light = false } = Astro.props;
---
<a href={url('/')} class:list={['logo', { 'logo--light': light }]} aria-label={`${site.legalName}: home`}>
  <BrandMark size={42} class="logo__mark" />
  <span class="logo__text">
    <span class="logo__name">{site.brand.wordmark || site.name}</span>
    {site.brand.wordmarkSub && <span class="logo__sub">{site.brand.wordmarkSub}</span>}
  </span>
</a>

<style>
  .logo { display: inline-flex; align-items: center; gap: 12px; color: var(--brand-accent); line-height: 1; }
  .logo :global(.logo__mark) { width: 42px; height: 42px; flex: none; }
  .logo__text { display: grid; justify-items: end; gap: 3px; }
  .logo__name { font-family: var(--font-sans); font-size: 27px; font-weight: 600; font-stretch: 100%; letter-spacing: -0.005em; line-height: 0.8; }
  .logo__sub { font-family: var(--font-sans); font-size: 9.5px; font-weight: 700; font-stretch: 100%; letter-spacing: 0.035em; }
  .logo--light { color: #fff; }
  .logo--light :global(.logo__mark rect[fill="var(--brand-primary)"]) { fill: color-mix(in srgb, var(--brand-primary) 45%, #5b9bff); }
  @media (max-width: 380px) {
    .logo { gap: 10px; }
    .logo :global(.logo__mark) { width: 36px; height: 36px; }
    .logo__name { font-size: 23px; }
    .logo__sub { font-size: 8.2px; }
  }
  @media (max-width: 340px) {
    .logo { gap: 8px; }
    .logo :global(.logo__mark) { width: 30px; height: 30px; }
    .logo__name { font-size: 19px; }
    .logo__sub { font-size: 6.8px; }
  }
</style>
