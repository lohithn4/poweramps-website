---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import site from '../data/site.json';
import { url } from '../lib/url';
import { getClients } from '../lib/clients';
import { getTestimonials } from '../lib/testimonials';
import { PANEL_TYPES, typeHref } from '../data/panel-types';

const year = new Date().getFullYear();
const hasClients = (await getClients()).length > 0 || (await getTestimonials()).length > 0;
// Floating 'Build your panel' button on public pages (not on the builder, account, staff or editor pages).
const showFab = !/\/(build|portal|staff|admin)(\/|$)/.test(Astro.url.pathname);
const a = site.address;
---
<footer class:list={["footer blueprint on-dark", { "footer--fab": showFab }]}>
  <div class="wrap">
    <div class="footer__grid">
      <div class="footer__brand">
        <Logo light />
        <p>{site.tagline}</p>
        <div class="footer__contact">
          {site.phone && <a href={`tel:${site.phone.replace(/\s/g, '')}`} title={site.contactName ? `${site.contactName}${site.contactRole ? `, ${site.contactRole}` : ''}` : undefined}><Icon name="phone" size={16} />{site.phone}</a>}
          {site.whatsapp && <a href={`https://wa.me/${site.whatsapp.replace(/\D/g, '')}`} target="_blank" rel="noopener"><Icon name="whatsapp" size={16} />WhatsApp {site.whatsapp}</a>}
          {site.email && <a href={`mailto:${site.email}`}><Icon name="mail" size={16} />{site.email}</a>}
          <a href={site.indiamart} target="_blank" rel="noopener"><Icon name="external" size={16} />View us on IndiaMART</a>
        </div>
      </div>

      <div>
        <h3 class="footer__h">Panels</h3>
        <ul class="footer__list">
          {PANEL_TYPES.filter((t) => t.slug !== 'lt-panel').map((t) => <li><a href={url(typeHref(t.slug))}>{t.short.charAt(0).toUpperCase() + t.short.slice(1)}</a></li>)}
          <li><a href={url(typeHref('lt-panel'))}>LT panels</a></li>
          <li><a href={url('/panels')}>All panels →</a></li>
        </ul>
      </div>

      <div>
        <h3 class="footer__h">Company</h3>
        <ul class="footer__list">
          <li><a href={url('/build/')}>Electric panel builder</a></li>
          <li><a href={url('/electrical-panel-manufacturer-bangalore/')}>Panel manufacturer, Bangalore / Bengaluru</a></li>
          <li><a href={url('/electrical-panel-manufacturer-karnataka/')}>Panel manufacturer, Karnataka</a></li>
          <li><a href={url('/electrical-panel-manufacturer-india/')}>Panel manufacturer, India</a></li>
          <li><a href={url('/about')}>About us</a></li>
          {hasClients && <li><a href={url('/clients')}>Clients &amp; testimonials</a></li>}
          <li><a href={url('/#capabilities')}>Capabilities</a></li>
          <li><a href={url('/#process')}>How we work</a></li>
          <li><a href={url('/#faq')}>FAQs</a></li>
          <li><a href={url('/contact')}>Contact & enquiry</a></li>
        </ul>
      </div>

      <div>
        <h3 class="footer__h">Works</h3>
        <address class="footer__addr">
          {a.line1},<br />
          {a.line2},<br />
          {a.city}, {a.state} {a.pincode}<br />
          {a.country}
        </address>
        {site.map?.link && (
          <a class="footer__map" href={site.map.link} target="_blank" rel="noopener"><Icon name="pin" size={15} />View on Google Maps</a>
        )}
      </div>
    </div>

    <div class="footer__base">
      <span>© {year} {site.legalName}</span>
      <span class="mono footer__gst" title="GST verified">GSTIN <Icon name="check" size={13} />{site.gst}</span>
    </div>
  </div>
</footer>

{showFab && (
  <a class="fab has-tip tip-up" href={url('/build/')} aria-describedby="tip-fab"><span class="fab__icon"><Icon name="layers" size={20} /></span><span>Build panel &amp; Quote</span><span class="tip" id="tip-fab" role="tooltip">Configure the panel to meet your requirements</span></a>
)}

<style>
  .fab {
    position: fixed; right: clamp(14px, 3vw, 28px); bottom: clamp(14px, 3vw, 28px); z-index: 900;
    display: inline-flex; align-items: center; gap: 10px; padding: 14px 20px; border-radius: 999px;
    background: var(--action); color: #fff; font-weight: 700; font-size: 15.5px;
    box-shadow: 0 14px 34px -10px color-mix(in srgb, var(--action) 80%, transparent), 0 2px 6px rgb(0 0 0 / 18%);
    animation: fab-float 3.6s ease-in-out infinite;
  }
  /* soft ring that pulses out from the button */
  .fab::before {
    content: ''; position: absolute; inset: 0; z-index: -1; border-radius: inherit;
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--action) 55%, transparent);
    animation: fab-ring 3.6s ease-out infinite;
  }
  .fab { isolation: isolate; }
  .fab.has-tip { position: fixed; }
  .fab__icon { display: inline-grid; animation: fab-tilt 3.6s ease-in-out infinite; }
  .fab:hover { filter: brightness(1.08); animation-play-state: paused; }
  .fab:hover .fab__icon, .fab:hover::before { animation-play-state: paused; }
  .fab:focus-visible { outline: 3px solid #fff; outline-offset: 3px; }
  /* out of the way while the mobile menu is open */
  :global(body:has([data-menu-btn][aria-expanded='true'])) .fab { display: none; }
  @keyframes fab-float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-4px); } }
  @keyframes fab-ring { 0%, 40% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--action) 50%, transparent); } 80%, 100% { box-shadow: 0 0 0 12px transparent; } }
  @keyframes fab-tilt { 0%, 70%, 100% { transform: none; } 78% { transform: rotate(-10deg); } 86% { transform: rotate(6deg); } 92% { transform: none; } }
  @media (max-width: 480px) { .fab { padding: 12px 16px; font-size: 14.5px; gap: 8px; } }
  @media (prefers-reduced-motion: reduce) { .fab, .fab::before, .fab__icon { animation: none; } }
  .footer { padding-block: 72px 28px; color: #aab4cc; }
  .footer--fab { padding-bottom: 92px; }
  .footer__gst { display: inline-flex; align-items: center; gap: 5px; }
  .footer__gst :global(svg) { color: #4ade80; stroke-width: 2.6; }
  .footer__grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.1fr;
    gap: 40px;
  }
  .footer__brand p { margin-top: 18px; max-width: 34ch; }
  .footer__contact { display: grid; gap: 10px; margin-top: 22px; }
  .footer__contact a { display: inline-flex; align-items: center; gap: 10px; color: #dfe5f2; width: fit-content; }
  .footer__contact a:hover { color: #fff; }
  .footer__h {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    font-stretch: 100%;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--brand-dark) 45%, white);
    margin-bottom: 16px;
  }
  .footer__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .footer__list a { color: #dfe5f2; }
  .footer__list a:hover { color: #fff; text-decoration: underline; text-underline-offset: 4px; }
  .footer__addr { font-style: normal; line-height: 1.7; color: #dfe5f2; }
  .footer__map { display: inline-flex; align-items: center; gap: 8px; margin-top: 14px; color: #fff; font-weight: 500; }
  .footer__map:hover { text-decoration: underline; text-underline-offset: 4px; }
  .footer__base {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px;
    margin-top: 56px; padding-top: 22px;
    border-top: 1px solid rgb(255 255 255 / 10%);
    font-size: 13px;
  }
  @media (max-width: 900px) {
    .footer__grid { grid-template-columns: 1fr 1fr; }
    .footer__brand { grid-column: 1 / -1; }
  }
  @media (max-width: 520px) {
    .footer__grid { grid-template-columns: 1fr; }
  }
</style>
