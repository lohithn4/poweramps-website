---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '../styles/global.css';
import '../styles/portal.css';
import '../styles/erp.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';
import { url } from '../lib/url';

interface Props {
  title?: string;
  /** Use this exact <title> instead of "<title> | <brand>". */
  fullTitle?: string;
  description?: string;
  image?: string;
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
}
const { title, fullTitle: fullTitleProp, description = site.description, image, jsonLd, noindex: noindexProp = false } = Astro.props;
// Client portal, staff screens and the content editor are private: never in search results.
const privatePage = /\/(portal|staff|admin)(\/|$)/.test(Astro.url.pathname);
const noindex = noindexProp || privatePage;
// Section-by-section scrolling on public pages (off where people fill in forms: builder, portal, staff).
const snap = !privatePage && !/\/build(\/|$)/.test(Astro.url.pathname);
// Short brand ("Poweramps") is what people type into Google; it leads the home title and is the site name.
const brand: string = (site as any).shortName || site.name;
const fullTitle = fullTitleProp ?? (title ? `${title} | ${brand}` : `${brand} | ${site.seoTitle}`);
// Brand colours from site.json → CSS variables (all other colours derive from these).
const hex = (v: string, d: string) => (/^#[0-9a-f]{3,8}$/i.test(v ?? '') ? v : d);
const brandCss = `html:root{--brand-primary:${hex(site.brand.primary, '#024998')};--brand-accent:${hex(site.brand.accent, '#cd030d')};--brand-dark:${hex(site.brand.dark, '#081129')};--brand-action:${hex((site.brand as any).action, '#1f5fcc')}}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Default share card (WhatsApp / LinkedIn / Facebook previews) is a 1200×630 image; product pages pass their photo.
const ogImage = new URL(url(image ?? '/brand/og.png'), Astro.site).href;
// Google wants a roughly square logo (min 112 px) for the business; the wide wordmark stays for og/brand use.
const logoSquare = new URL(url('/brand/logo-square.png'), Astro.site).href;

const lat = Number((site as any).map?.lat), lng = Number((site as any).map?.lng);
const org = {
  '@type': 'LocalBusiness',
  '@id': new URL(url('/#business'), Astro.site).href,
  name: site.name,
  legalName: site.legalName,
  alternateName: [...new Set([brand, site.legalName, (site.brand as any).wordmark && `${site.brand.wordmark} ${site.brand.wordmarkSub ?? ''}`.trim()].filter((n) => n && n !== site.name))],
  description: site.description,
  image: [new URL(url('/brand/og.png'), Astro.site).href, new URL(url('/brand/logo.png'), Astro.site).href],
  url: new URL(url('/'), Astro.site).href,
  logo: logoSquare,
  foundingDate: String(site.established),
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${site.address.line1}, ${site.address.line2}`,
    addressLocality: site.address.city,
    addressRegion: site.address.state,
    postalCode: site.address.pincode,
    addressCountry: 'IN',
  },
  ...(Number.isFinite(lat) && Number.isFinite(lng) && lat && lng ? { geo: { '@type': 'GeoCoordinates', latitude: lat, longitude: lng } } : {}),
  ...((site as any).map?.link ? { hasMap: (site as any).map.link } : {}),
  ...(site.phone ? { telephone: site.phone } : {}),
  ...(site.email ? { email: site.email } : {}),
  ...((site as any).gst ? { taxID: (site as any).gst } : {}),
  ...((site as any).indiamart || (site as any).map?.link ? { sameAs: [(site as any).indiamart, (site as any).map?.link].filter(Boolean) } : {}),
  areaServed: [
    { '@type': 'City', name: site.address.city, ...(site.address.city === 'Bengaluru' ? { alternateName: 'Bangalore' } : {}) },
    { '@type': 'Country', name: 'India' },
  ],
  makesOffer: { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Custom electric panel builder (online)', url: new URL(url('/build/'), Astro.site).href } },
  knowsAbout: ['Custom electrical panels', 'MCC panels', 'PLC panels', 'VFD panels', 'AMF panels', 'DG synchronization panels', 'Fire fighting panels', 'Power distribution panels', 'LT panels'],
};
// WebSite node: tells Google the site's name ("Poweramps") for the search result header.
const website = {
  '@type': 'WebSite',
  '@id': new URL(url('/#website'), Astro.site).href,
  name: brand,
  alternateName: [...new Set([site.name, site.legalName, Astro.site?.host.replace(/^www\./, '')].filter((n) => n && n !== brand))],
  url: new URL(url('/'), Astro.site).href,
  inLanguage: 'en-IN',
  publisher: { '@id': org['@id'] },
};
// Every public page carries the site + business nodes; page-specific nodes (product, FAQ, breadcrumbs) join the same graph.
const pageNodes = jsonLd ? ((jsonLd['@graph'] as unknown[]) ?? [(({ ['@context']: _c, ...rest }) => rest)(jsonLd)]) : [];
const graph = { '@context': 'https://schema.org', '@graph': [website, org, ...pageNodes] };
---
<!doctype html>
<html lang="en-IN" class:list={[{ snap }]} data-brand={site.name} data-api={import.meta.env.PUBLIC_API_URL || site.apiUrl}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="icon" type="image/png" sizes="512x512" href={url('/brand/logo-square.png')} />
    <link rel="apple-touch-icon" href={url('/brand/logo-square.png')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <meta name="theme-color" content={hex(site.brand.dark, "#081129")} />
    <style set:html={brandCss}></style>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brand} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_IN" />
    <meta name="twitter:card" content="summary_large_image" />
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(graph)} />}
  </head>
  <body>
    <a class="sr-only" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      import '../scripts/swipe-pages';
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => {
            if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
          }),
          { rootMargin: '0px 0px -8% 0px' },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-in'));
      }
    </script>
  </body>
</html>
